AZICURE_MASTER_KEY_FILE=./configs/master_key.bin
AZICURE_DEVICE_REGISTRY=./configs/device_registry.signed.json
AZICURE_LOG_DIR=./logs
AZICURE_TAMPER_MANIFEST=./configs/tamper_manifest.signed.json
AZICURE_ISSUER=Azicure
AZICURE_TOTP_DIGITS=6
AZICURE_TOTP_STEP=30
AZICURE_ADMIN_EMAIL=admin@example.com

# JWT/OAuth secrets (development only)
AZICURE_JWT_SECRET=dev-secret-change-me
AZICURE_JWT_EXPIRE_MIN=60

# Admin default user (for demo)
AZICURE_ADMIN_USER=admin
AZICURE_ADMIN_PASS=admin123

# Ed25519 signing keys (generated via CLI if missing)
AZICURE_SIGN_PRIV=./configs/signing_ed25519_private.key
AZICURE_SIGN_PUB=./configs/signing_ed25519_public.key
